{
    "name": "cellcube/core-activemiddleware-module",
    "description": "Admin management package for Lumen 11",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "tymon/jwt-auth": "^2.0",
        "spatie/laravel-permission": "^6.23"
    },
    "autoload": {
        "psr-4": {
            "CellcubeActiveMiddleware\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CellcubeActiveMiddleware\\MiddlewareServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
